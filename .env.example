# Copy to .env and adjust as needed. docker-compose auto-loads this file
# and passes these through to the container.

# Signs the fake-login session cookie.
SESSION_SECRET=change-me-for-anything-non-local

# OpenRouter key for the AI drafting chat (LiteLLM -> OpenRouter -> Cerebras).
# Without it the /api/chat endpoint returns HTTP 502; the rest of the app runs.
OPENROUTER_API_KEY=
